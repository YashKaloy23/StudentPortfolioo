
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.testng.Assert;
import org.testng.annotations.AfterMethod;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.Test;

public class PortfolioTest {

    WebDriver driver;

    @BeforeMethod
    public void setup() {
        driver = new ChromeDriver();
        driver.manage().window().maximize();

        driver.get(
          "file:///ABSOLUTE_PATH/StudentPortfolio/src/main/resources/website/index.html"
        );
    }

    @Test
    public void verifyHomePage() {
        Assert.assertTrue(
            driver.getTitle().contains("Portfolio")
        );
    }

    @Test
    public void verifyAboutSection() {
        Assert.assertTrue(
            driver.findElement(By.id("about")).isDisplayed()
        );
    }

    @Test
    public void verifyEducationSection() {
        Assert.assertTrue(
            driver.findElement(By.id("education")).isDisplayed()
        );
    }

    @Test
    public void verifySkillsSection() {
        Assert.assertTrue(
            driver.findElement(By.id("skills")).isDisplayed()
        );
    }

    @Test
    public void verifyProjectsSection() {
        Assert.assertTrue(
            driver.findElement(By.id("projects")).isDisplayed()
        );
    }

    @Test
    public void verifyContactForm() {
        Assert.assertTrue(
            driver.findElement(By.id("contactForm")).isDisplayed()
        );
    }

    @Test
    public void verifyContactFormSubmission() {
        driver.findElement(By.id("name")).sendKeys("Test Student");
        driver.findElement(By.id("email")).sendKeys("test@example.com");
        driver.findElement(By.id("message")).sendKeys("Hello Portfolio");

        driver.findElement(
            By.cssSelector("#contactForm button[type='submit']")
        ).click();

        String result = driver.findElement(
            By.id("formStatus")
        ).getText();

        Assert.assertTrue(result.contains("Thank you"));
    }

    @AfterMethod
    public void tearDown() {
        if (driver != null) {
            driver.quit();
        }
    }
}
